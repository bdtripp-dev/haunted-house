FROM eclipse-temurin:21-jdk
WORKDIR /app
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
RUN ./mvnw -q dependency:go-offline
COPY src ./src
RUN ./mvnw -q package -DskipTests
RUN ./mvnw -q dependency:copy-dependencies
CMD ["java", "-cp", "target/classes:target/dependency/*", "com.bdtripp.hauntedhouse.WebApp"]
